# Platform definitions for the ark-resolver server and image.
#
# Bazel resolves toolchains and `select()` branches against constraints; these
# platforms compose the standard `@platforms//os:*` and `@platforms//cpu:*`
# constraints into the three (os, cpu) pairs this build targets:
# darwin-aarch64 (local dev), linux-x86_64 (the published image), and
# linux-aarch64 (CI).
#
# Package default visibility is `//:__pkg__`, not private: the root package
# will reference `//platforms:linux_x86_64` (oci_image's target platform) and
# the config_settings below in a `select()`. Bazel 9.1.0 enforces
# `config_setting` visibility by default
# (`--incompatible_enforce_config_setting_visibility`), so it must be granted
# explicitly rather than left at the implicit public default.
package(default_visibility = ["//:__pkg__"])

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "darwin_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

# Config settings for per-platform `select()` branches in BUILD files.
# `platform()` cannot be used in `select()`; `config_setting` can.
config_setting(
    name = "is_linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "is_linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "is_darwin_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)
