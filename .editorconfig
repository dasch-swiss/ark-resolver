# Editor defaults for every file type. Where a formatter owns a type, the values below
# repeat its settings and must change with them: ruff in pyproject.toml, rustfmt's
# defaults (no rustfmt.toml), `just --fmt` for the justfile. No formatter runs on Bazel
# files; their 4 spaces follow buildifier's style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 140

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

[{*.bazel,*.bzl,justfile}]
indent_style = space
indent_size = 4

[{*.yml,*.yaml,*.json,*.nix}]
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# A patch's context lines must match the patched file byte for byte.
[*.patch]
trim_trailing_whitespace = false
insert_final_newline = unset
