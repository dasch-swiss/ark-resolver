# Every environment variable ark-resolver reads. Nothing loads this file:
# export the variables in your shell or set them in the deployment.
# Uncommented values are the defaults the code uses when a variable is unset.
# A variable Rust reads or logs is also in the EnvVarDefinition table in
# src/adapters/environment/env_logger.rs; Python and Rust each read the ARK_* server variables.

# --- Required ---
# Path or http(s) URL of the ARK registry INI. `bazel run` needs an absolute path;
# `just run` sets it to tests/ark-registry.ini. Production and staging use
# dasch-swiss/ark-resolver-data.
ARK_REGISTRY=/absolute/path/to/tests/ark-registry.ini

# --- Server ---
ARK_EXTERNAL_HOST=ark.example.org
ARK_INTERNAL_HOST=0.0.0.0
ARK_INTERNAL_PORT=3336
# Name Assigning Authority Number; DaSCH's production NAAN is 72163.
ARK_NAAN=00000
# Whether the service runs behind an HTTPS proxy (true: generated ARK URLs use https).
ARK_HTTPS_PROXY=true
# HMAC secret verifying GitHub's POST /reload webhook.
ARK_GITHUB_SECRET=

# --- Rust settings loader and HTTP client ---
# Application-level timeout for loading settings; keeps a slow registry fetch from
# outliving the orchestrator's start-up window (SIGTERM).
ARK_RUST_LOAD_TIMEOUT_MS=15000
ARK_RUST_HTTP_TIMEOUT_MS=10000
ARK_RUST_HTTP_CONNECT_TIMEOUT_MS=5000
# true disables IPv6 for the registry fetch (container IPv6 connectivity issues).
ARK_RUST_FORCE_IPV4=false
# Outbound proxy for the registry fetch; HTTPS_PROXY, HTTP_PROXY and ALL_PROXY
# (either case) are honoured after it.
# ARK_OUTBOUND_PROXY=

# --- Observability ---
# Sentry is off unless a DSN is set.
# ARK_SENTRY_DSN=
# ARK_SENTRY_ENVIRONMENT=
# ARK_SENTRY_RELEASE=
# true, 1, yes or on enable Sentry's debug mode.
ARK_SENTRY_DEBUG=false
# true also prints OpenTelemetry spans to the console.
ARK_TRACING_CONSOLE=false
# Rust tracing filter, e.g. ark_resolver=debug,reqwest=debug,hyper=debug
# RUST_LOG=

# --- Reported by GET /health/ ---
# VERSION=0.1.0
# GIT_COMMIT_HASH=unknown
